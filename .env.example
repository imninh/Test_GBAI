# ============================================
# GreenBin AI (VHR-17) — Environment Variables
# ============================================
# Copy file này thành .env rồi điền giá trị. KHÔNG BAO GIỜ commit .env.

# ---- Nhà cung cấp model vision (tầng T1/T2) ----
# gemini | openai | openrouter | nvidia | local_only
# Đổi provider chỉ cần sửa dòng này, không sửa code.
# Lưu ý: DeepSeek KHÔNG nhận ảnh (chỉ text) nên không dùng được cho T1/T2.
VISION_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
DEEPSEEK_API_KEY=

# Để trống thì lấy mặc định theo provider (xem src/config.py resolve_models).
#   gemini      → gemini-flash-lite-latest / gemini-flash-latest
#                 (KHONG dung gemini-2.5-flash / -2.5-pro: Google da dong voi
#                  key tao moi, goi that tra 404 du van hien trong /models)
#   openai      → gpt-4o-mini / gpt-4o
#   openrouter  → openai/gpt-4o-mini / openai/gpt-4o
#   nvidia      → meta/llama-3.2-11b-vision-instruct / …-90b-…
VISION_MODEL_T1=
VISION_MODEL_T2=
TEXT_MODEL=

# ---- Tầng T0.5: model local chạy offline trên CPU ----
LOCAL_MODEL_ENABLED=true
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
CLIP_ACCEPT_CONFIDENCE=0.82

# ---- Ngưỡng an toàn và HITL ----
HITL_WEIGHT_THRESHOLD_KG=30
HITL_ITEM_COUNT_THRESHOLD=3
HAZARDOUS_MIN_CONFIDENCE=0.80
PHASH_MAX_DISTANCE=6

# ---- Database ----
DATABASE_URL=sqlite:///./data/app.db
# Khi deploy PostgreSQL:
# DATABASE_URL=postgresql://user:password@host:5432/greenbin

# ---- Ảnh và quyền riêng tư ----
MEDIA_DIR=./data/media
MEDIA_MAX_EDGE_PX=512
MEDIA_RETENTION_DAYS=30
FACE_BLUR_ENABLED=true

# ---- Xác thực (tự làm auth thay Supabase — ADR-0004) ----
JWT_SECRET=doi-chuoi-nay-truoc-khi-deploy
JWT_EXPIRE_MINUTES=720

# ---- App ----
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Kiểm soát chi phí ----
BUDGET_LIMIT_USD=25
LLM_CACHE_DIR=./data/cache
CHROMA_PERSIST_DIR=./data/chroma

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=greenbin-ai
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- AI Hook Logging (BTC cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=thay-bang-key-rieng-tu-link-moi-cua-BTC
AI_LOG_DIR=.ai-log

# ---- Frontend ----
NEXT_PUBLIC_API_URL=http://localhost:8000
