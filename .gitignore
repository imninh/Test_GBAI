# Python
__pycache__/
*.py[cod]
*.so
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment variables
.env
.env.local
.env.production

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (never commit large data)
data/
*.db
*.sqlite3

# Bộ model T0.5 dạng ONNX (~89 MB) — commit vào đây là nó nằm trong lịch sử git
# vĩnh viễn. Sinh lại bằng `python scripts/export_clip_onnx.py`, rồi đính vào
# GitHub Release và trỏ CLIP_ASSETS_URL vào đó. Xem ADR-0007.
assets/clip/*.onnx
assets/clip/clip_text_embeddings.json
# Gói nén để đính vào Release — cũng không commit, vì lý do y hệt.
clip-assets.tar.gz

# ...nhưng dữ liệu mẫu PHẢI commit — là một phần của hồ sơ bàn giao
!data/samples/
!data/samples/**

# Logs
logs/
*.log

# Test coverage
htmlcov/
.coverage
coverage.xml

# Docker
docker-compose.override.yml

# Node (frontend)
node_modules/
.next/
out/
.nuxt/

# App Android (Capacitor) — khung dự án PHẢI commit vì GitHub Actions build từ
# đó, nhưng phần sinh ra lúc build thì không.
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/.idea/
frontend/android/capacitor-cordova-android-plugins/
# Bản chép của `frontend/out`, do `npx cap sync` sinh lại mỗi lần build.
frontend/android/app/src/main/assets/public/
frontend/android/app/src/main/assets/capacitor.config.json
frontend/android/app/src/main/assets/capacitor.plugins.json

# Build
*.pyc
*.pyo

# AI logs — tracked structure, ignored content
.ai-log/*.jsonl
.ai-log/archive/
